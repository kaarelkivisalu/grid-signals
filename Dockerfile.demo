FROM ghcr.io/astral-sh/uv:0.13.5@sha256:32a7bb39b496babbd997b0a39a4d66c126bdaf5661b302bf6f06abda8deca6ff AS uv

FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704 AS bundle

WORKDIR /source
COPY scripts/prepare_demo.py /source/scripts/prepare_demo.py
COPY src/grid_signals/__init__.py /source/src/grid_signals/__init__.py
COPY src/grid_signals/app/ /source/src/grid_signals/app/
COPY .streamlit/config.toml /source/.streamlit/config.toml
RUN python scripts/prepare_demo.py --output /prepared

FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704

WORKDIR /app
ENV VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"
COPY deploy/demo/requirements.txt /app/requirements.txt
RUN --mount=from=uv,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/root/.cache/uv \
    uv venv --python /usr/local/bin/python /opt/venv \
    && uv pip sync --require-hashes --compile-bytecode --link-mode=copy requirements.txt \
    && useradd --create-home --uid 10001 app

COPY --from=bundle /prepared/ /app/
ENV PYTHONPATH=/app/src \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
USER app
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3)"
CMD ["python", "-m", "streamlit", "run", "src/grid_signals/app/main.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
