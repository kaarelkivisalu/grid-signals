FROM python:3.12-slim

WORKDIR /app
COPY deploy/demo/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && useradd --create-home --uid 10001 app

COPY src/ /app/src/
COPY .streamlit/config.toml /app/.streamlit/config.toml
ENV PYTHONPATH=/app/src \
    GRID_SIGNALS_DEMO_ONLY=1 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
USER app
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=3)"
CMD ["python", "-m", "streamlit", "run", "src/grid_signals/app/main.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
