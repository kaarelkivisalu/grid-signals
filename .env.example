ENTSOE_API_KEY=
# Forecast and export directories may be absolute paths to mounted volumes.
GRID_SIGNALS_DATA_DIR=research/data
GRID_SIGNALS_OUTPUT_DIR=data/exports
# Optional: GRID_SIGNALS_CONFIG_DIR, GRID_SIGNALS_REPORTS_DIR, GRID_SIGNALS_MLRUNS_DIR

# Compose starts with schedules paused. Set false only after the producer is checked
# and the old local timers are disabled.
GRID_SIGNALS_SCHEDULES_PAUSED=true
GRID_SIGNALS_IMAGE_TAG=local
GRID_SIGNALS_RUNNER_MEMORY=3g
GRID_SIGNALS_RUNNER_CPUS=2
